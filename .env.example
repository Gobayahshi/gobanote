# =====================================================================
# 고바노트(Goba.note) 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 로 Git 추적에서 제외됩니다. 실제 키를 여기에 쓰지 마세요.
# =====================================================================

# ---------------------------------------------------------------------
# 1) Expo 앱에서 사용하는 값
#    EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 포함됩니다.
#    → 공개돼도 안전한 값(anon key)만 넣습니다.
# ---------------------------------------------------------------------

# Supabase 프로젝트 URL  (예: https://xxxxxxxxxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon(public) key — RLS 로 보호되는 공개 키
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# 2) Supabase Edge Function(classify-note) 서버 비밀값
#    아래 값들은 .env 나 앱 번들이 아니라
#    Supabase 대시보드 또는 CLI 로만 설정합니다.
#      supabase secrets set GEMINI_API_KEY=...
#    ※ Gemini 키를 Expo 앱에 넣지 않습니다. (명세서 3장)
#    아래는 "이런 비밀값이 필요하다"는 문서 용도이며, 값은 비워 둡니다.
# ---------------------------------------------------------------------

# GEMINI_API_KEY=            # Edge Function 전용. 로컬 .env 에 넣지 말 것
# SUPABASE_SERVICE_ROLE_KEY= # Edge Function 런타임이 자동 주입. 앱에서 사용 금지
